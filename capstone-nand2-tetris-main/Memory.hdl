// Memory.hdl - Hack data memory map (Nand to Tetris, Project 5)
//   0..16383   : RAM16K
//   16384..24575: Screen (8K)
//   24576      : Keyboard
CHIP Memory {
    IN  in[16], load, address[15];
    OUT out[16];

    PARTS:
    // address[13..14]: 00,01 -> RAM   10 -> Screen   11 -> Keyboard
    DMux4Way(in=load, sel=address[13..14], a=ld0, b=ld1, c=ldScreen, d=ldKbd);
    Or(a=ld0, b=ld1, out=ldRam);

    RAM16K(in=in, load=ldRam, address=address[0..13], out=ramOut);
    Screen(in=in, load=ldScreen, address=address[0..12], out=screenOut);
    Keyboard(out=kbdOut);

    Mux4Way16(a=ramOut, b=ramOut, c=screenOut, d=kbdOut, sel=address[13..14], out=out);
}
